<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <title>LowEndInsight</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.8.0/css/bulma.min.css">
    <link rel="stylesheet" href = "../css/endpoints.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script>
      // Inline and synchronous on purpose: a deferred script runs after first
      // paint, and the flash of the wrong theme is the thing being avoided.
      (function () {
        try {
          var t = localStorage.getItem("lei-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <script type="text/javascript" defer src="https://use.fontawesome.com/releases/v5.3.1/js/all.js"></script>
    <a href="https://github.com/kitplummer/lowendinsight" target="_blank" class="github-corner" aria-label="View source on GitHub">
      <svg class="svg" width="80" height="80" viewBox="0 0 250 250" aria-hidden="true">
        <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
        <path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3
          123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm">
        </path>
        <path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,
          88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5
          178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9
          C212.7, 93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,
          116.9 156.7, 120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor"
          class="octo-body">
        </path>
      </svg>
    </a>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-40VJ6VCWDL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-40VJ6VCWDL');
    </script>
  </head>
  <body>
    <script src="../js/endpoints.js" type="text/javascript"></script>
    <section class="section">
      <div id="input-box" class="columns is-centered">
        <div class="column is-narrow is-vcentered">
          <p>
            <br/>
            <img id="lei" src="../images/lei_bus_128.png">
          </p>
        </div>
        <div class="column is-narrow is-vcentered">
          <h1 class="title">
            <a href="https://lowendinsight.fly.dev" target="_blank">LowEndInsight</a>
          </h1>
          <form id="form" class="input-field" action="/url=" method="get" onsubmit="return validate_and_submit(event)">
            <input type="text" id="input-url" class="search" placeholder="Enter public git repo URL" required oninput="remove_error()">
            <button type="submit" id="analyze-button" class="button is-dark is-family-code">Analyze</button>
          </form>
          <span id="invalid-url">Invalid repo URL</span>
          <div class="buttons-div">
            <button class="button is-warning">
              <a class="is-family-code" href="/doc"><i class="fas fa-book-open"></i>Manual</a>
            </button>
            <button class="button is-success">
              <a class="is-family-code" href="/gh_trending"><i class="fab fa-github"></i>Trending</a>
            </button>
          </div>
        </div>
      </div>
    </section>
    <% v = LeiService.ReportView %>
    <% r = v.decode(report) %>
    <% data = r["data"] || %{} %>
    <% results = data["results"] || %{} %>
    <% git = data["git"] || %{} %>
    <% files = data["files"] || %{} %>
    <% header = r["header"] || %{} %>
    <% {:ok, slug} = Helpers.get_slug(url) %>
    <section class="section report-detail" id="report">
      <div class="container">
        <%# Not <header>: endpoints.css fixes every header at 50px tall. %>
        <div class="report-head">
          <p class="report-kicker">Repository report</p>
          <h2 class="title is-3 report-title">
            <%= if href = v.project_href(data["repo"]) do %>
              <a href="<%= href %>" target="_blank" rel="noopener noreferrer"><%= slug %></a>
            <% else %>
              <%= slug %>
            <% end %>
          </h2>
          <p class="report-meta">
            Analyzed <%= v.date(header["end_time"]) %> · LowEndInsight <%= v.show(header["library_version"]) %>
          </p>
          <p class="report-overall">
            <span class="report-overall-label">Overall risk</span>
            <span class="risk-badge <%= v.risk_class(data["risk"]) %>"><%= v.risk_label(data["risk"]) %></span>
          </p>
        </div>

        <div class="columns is-multiline report-cards">
          <%= for {title, value, detail, risk} <- [
                {"Contributors", v.show(results["contributor_count"]), "people with commits", results["contributor_risk"]},
                {"Functional contributors", v.show(results["functional_contributors"]), "carrying their share of commits", results["functional_contributors_risk"]},
                {"Commit currency", v.show(results["commit_currency_weeks"]), "weeks since the last commit", results["commit_currency_risk"]},
                {"Large recent commit", v.percent(results["recent_commit_size_in_percent_of_codebase"]), "of the codebase in the latest commit", results["large_recent_commit_risk"]},
                {"SBOM", "", "whether the project publishes a bill of materials", results["sbom_risk"]},
                {"Agentic contribution", v.show(results["agentic_classification"]), "#{v.ratio(results["agentic_contribution_ratio"])} of commits by agents", nil}
              ] do %>
            <div class="column is-half-tablet is-one-third-desktop">
              <div class="report-card">
                <p class="report-card-title"><%= title %></p>
                <%= if value != "" do %>
                  <p class="report-card-value"><%= value %></p>
                <% end %>
                <p class="report-card-detail"><%= detail %></p>
                <%= if risk do %>
                  <span class="risk-badge <%= v.risk_class(risk) %>"><%= v.risk_label(risk) %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <h3 class="title is-5 report-section">Repository</h3>
        <div class="table-container">
          <table class="table is-fullwidth report-facts">
            <tbody>
              <tr><th>Default branch</th><td><code><%= v.branch(git["default_branch"]) %></code></td></tr>
              <tr><th>Last commit</th><td><%= v.date(git["last_commit_date"]) %></td></tr>
              <tr><th>Commits on default branch</th><td><%= v.show(git["total_commits_on_default_branch"]) %></td></tr>
              <tr><th>Files</th><td><%= v.show(files["total_file_count"]) %> (<%= v.show(files["binary_files_count"]) %> binary)</td></tr>
              <tr><th>README · LICENSE · CONTRIBUTING</th><td><%= v.show(files["has_readme"]) %> · <%= v.show(files["has_license"]) %> · <%= v.show(files["has_contributing"]) %></td></tr>
              <tr><th>Loose objects</th><td><%= v.loose_objects(data["repo_size"]) %></td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="title is-5 report-section">Top contributors</h3>
        <%= if (results["top10_contributors"] || []) == [] do %>
          <p class="report-empty">No contributors recorded.</p>
        <% else %>
          <div class="table-container">
            <table class="table is-fullwidth is-striped report-contributors">
              <thead>
                <tr><th>Name</th><th>Commits</th><th>Merges</th><th>Last contribution</th><th>Classification</th></tr>
              </thead>
              <tbody>
                <%= for c <- results["top10_contributors"] do %>
                  <tr>
                    <td><%= v.show(c["name"]) %></td>
                    <td><%= v.show(c["contributions"]) %></td>
                    <td><%= v.show(c["merges"]) %></td>
                    <td><%= v.date(c["last_contribution_date"]) %></td>
                    <td><%= v.show(c["classification"]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <details class="report-details">
          <summary>Scoring thresholds</summary>
          <div class="table-container">
            <table class="table is-narrow report-facts">
              <tbody>
                <%= for {k, val} <- v.thresholds(data["config"]) do %>
                  <tr><th><code><%= k %></code></th><td><%= v.show(val) %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </details>

        <details class="report-details report-json">
          <summary>Full report (JSON)</summary>
          <pre><%= v.pretty_json(r) %></pre>
        </details>

        <%# Machine-readable copy: scripts/canary.sh reads the report from here. %>
        <script type="application/json" id="report-data"><%= Lei.Web.HTML.script_json(r) %></script>
      </div>
    </section>
      <button id="theme-toggle" class="theme-toggle" type="button">Dark mode</button>
    <script src="/js/theme.js" type="text/javascript"></script>
</body>
  <footer id="footer" class="footer">
    <div class="content has-text-centered">
      <p>LowEndInsight is developed and operated by <a href="https://revolveteam.com"><strong>(r)evolve</strong></a>.</p>
      <p style="font-size: 0.85rem;">Originally created as research at
        <a href="https://gtri.gatech.edu">GTRI</a> &mdash; BSD 3-Clause License</p>
      <p style="font-size: 0.75rem; color: var(--text-muted);">v<%= version %></p>
    </div>
  </footer>
</html>
