{
  "name": "vscode-lowendinsight",
  "displayName": "LowEndInsight",
  "description": "(Beta) Bus-factor and maintenance risk for your dependencies, from LowEndInsight",
  "version": "0.16.2",
  "preview": true,
  "publisher": "revolve",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "supply-chain",
    "bus-factor",
    "dependencies",
    "risk"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/mix.exs",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/Gemfile",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "LowEndInsight",
      "properties": {
        "lowendinsight.apiUrl": {
          "type": "string",
          "default": "https://lowendinsight.dev",
          "description": "The LowEndInsight service. Change it only for a self-hosted deployment."
        },
        "lowendinsight.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "Analyse when a workspace opens and when a manifest changes, once an API key is set (LEI: Set API Key). The dependency list is sent to the service at apiUrl."
        }
      }
    },
    "commands": [
      {
        "command": "lowendinsight.analyze",
        "title": "LEI: Analyze Dependencies",
        "icon": "$(shield)"
      },
      {
        "command": "lowendinsight.analyzeFile",
        "title": "LEI: Analyze Current Manifest"
      },
      {
        "command": "lowendinsight.clearDiagnostics",
        "title": "LEI: Clear Diagnostics"
      },
      {
        "command": "lowendinsight.setApiKey",
        "title": "LEI: Set API Key"
      },
      {
        "command": "lowendinsight.getApiKey",
        "title": "LEI: Get a Free API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lowendinsight",
          "title": "LowEndInsight",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "lowendinsight": [
        {
          "id": "lowendinsight.riskView",
          "name": "Dependency Risk"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies --pre-release"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.1.1",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kitplummer/lowendinsight",
    "directory": "apps/lei_service/vscode-lowendinsight"
  },
  "homepage": "https://lowendinsight.dev",
  "bugs": {
    "url": "https://github.com/kitplummer/lowendinsight/issues"
  }
}
