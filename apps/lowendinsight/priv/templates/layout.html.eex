<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LEI — LowEndInsight</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.0/css/bulma.min.css">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/css/lei.css">
  <link rel="stylesheet" href="/css/theme.css">
  <script>
    (function () {
      try {
        var t = localStorage.getItem("lei-theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <nav class="navbar is-dark" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
      <a class="navbar-item" href="/">
        <img src="/images/lei_bus_128.png" alt="LEI" style="max-height:40px;">
      </a>
    </div>
    <div class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="/signup">Signup</a>
        <a class="navbar-item" href="/login">Login</a>
        <a class="navbar-item" href="/dashboard">Dashboard</a>
        <a class="navbar-item" href="/recover">Recover</a>
        <a class="navbar-item" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <section class="section">
    <div class="container">
      <%= if assigns[:flash_error] do %>
        <div class="notification is-danger"><%= @flash_error %></div>
      <% end %>
      <%= if assigns[:flash_info] do %>
        <div class="notification is-info"><%= @flash_info %></div>
      <% end %>
      <%= @inner_content %>
    </div>
  </section>

  <footer class="footer">
    <div class="content has-text-centered">
      <p>LowEndInsight &mdash; Bus-factor risk analysis</p>
    </div>
  </footer>
  <button id="theme-toggle" class="theme-toggle" type="button">Dark mode</button>
  <script src="/js/theme.js" type="text/javascript"></script>
</body>
</html>
